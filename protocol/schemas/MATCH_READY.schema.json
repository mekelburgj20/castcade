{
  "$id": "https://castcade.dev/protocol/v2/MATCH_READY.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "matchId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "The Throwdown code from ArcAid, or any unique string in a local/fake match."
    },
    "ballsPerGame": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "playerOrder": {
      "minItems": 2,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "description": "Stable participant id for this match: the ArcAid user id, or a fakeclient label."
      },
      "description": "Rotation order. Ball 1 of each player in this order, then ball 2, and so on."
    },
    "participants": {
      "minItems": 2,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "playerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "description": "Stable participant id for this match: the ArcAid user id, or a fakeclient label."
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "publicKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]+={0,2}$",
            "description": "Ed25519 public key, 32 raw bytes, base64."
          },
          "rig": {
            "type": "string",
            "enum": [
              "pc",
              "vr_headset",
              "real_cabinet"
            ],
            "description": "The player's declared rig, for provenance (ArcAid badge, never a gate)."
          }
        },
        "required": [
          "playerId",
          "displayName",
          "publicKey",
          "rig"
        ],
        "additionalProperties": false
      }
    },
    "hostPlayerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "description": "Stable participant id for this match: the ArcAid user id, or a fakeclient label."
    },
    "hostPublicKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$",
      "description": "Ed25519 public key, 32 raw bytes, base64."
    },
    "game": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "vpx",
            "arcade"
          ],
          "description": "Emulator family."
        },
        "tableName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Human name of the table or ROM set."
        },
        "tableHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the ORIGINAL .vpx (never the patched copy), or of the arcade ROM zip."
        },
        "romName": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ],
          "description": "PinMAME ROM set name (e.g. mm_109c) or arcade ROM name; null for originals."
        },
        "romHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "Lower-case hex SHA-256."
            },
            {
              "type": "null"
            }
          ],
          "description": "SHA-256 of the ROM zip; null for originals."
        },
        "physicsHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "Lower-case hex SHA-256."
            },
            {
              "type": "null"
            }
          ],
          "description": "Hash of the physics-relevant table settings; null when not computed."
        },
        "recipeVersion": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 32
            },
            {
              "type": "null"
            }
          ],
          "description": "Castcade patch recipe version applied to this table (ADR 0004); null for arcade."
        },
        "sidecarHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "Lower-case hex SHA-256."
            },
            {
              "type": "null"
            }
          ],
          "description": "SHA-256 of the generated sidecar .vbs; proves both players run the same patch."
        },
        "emulatorVersion": {
          "type": "string",
          "maxLength": 64,
          "description": "VPX or RetroArch core version string."
        }
      },
      "required": [
        "kind",
        "tableName",
        "tableHash",
        "romName",
        "romHash",
        "physicsHash",
        "recipeVersion",
        "sidecarHash",
        "emulatorVersion"
      ],
      "additionalProperties": false,
      "description": "The agreed fingerprint every participant matched."
    },
    "seed": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ],
      "description": "Unused in v1; reserved for v2 determinism."
    },
    "turnMode": {
      "type": "string",
      "enum": [
        "alternating",
        "simultaneous"
      ],
      "description": "Simultaneous (arcade netplay) skips TURN_GRANT entirely."
    }
  },
  "required": [
    "matchId",
    "ballsPerGame",
    "playerOrder",
    "participants",
    "hostPlayerId",
    "hostPublicKey",
    "game",
    "seed",
    "turnMode"
  ],
  "additionalProperties": false,
  "description": "host -> all. The roster is final; grants follow."
}
