{
  "$id": "https://castcade.dev/protocol/v2/DMD_FRAME.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "bitmap"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "bitsPerPixel": {
          "anyOf": [
            {
              "type": "number",
              "const": 2
            },
            {
              "type": "number",
              "const": 4
            },
            {
              "type": "number",
              "const": 8
            }
          ]
        },
        "encoding": {
          "type": "string",
          "const": "rle8-base64",
          "description": "Byte-oriented run-length encoding, then base64; defined in SPEC.md."
        },
        "data": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+={0,2}$",
          "description": "Standard base64, padded."
        }
      },
      "required": [
        "kind",
        "width",
        "height",
        "bitsPerPixel",
        "encoding",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "text"
        },
        "lines": {
          "minItems": 1,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          }
        }
      },
      "required": [
        "kind",
        "lines"
      ],
      "additionalProperties": false
    }
  ],
  "description": "client -> host on change, mirrored to the other clients. Drawn crisp in the overlay."
}
