{
  "$id": "https://castcade.dev/protocol/v1/REJECT.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "refSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "The seq of the message being rejected."
    },
    "refType": {
      "type": "string",
      "maxLength": 32
    },
    "code": {
      "type": "string",
      "enum": [
        "not_grant_holder",
        "stale_grant",
        "bad_signature",
        "unexpected_state",
        "schema",
        "unknown_player"
      ]
    },
    "message": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [
    "refSeq",
    "refType",
    "code",
    "message"
  ],
  "additionalProperties": false,
  "description": "host -> client. A message was ignored; diagnostic only, never changes match state."
}
