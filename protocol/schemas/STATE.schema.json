{
  "$id": "https://castcade.dev/protocol/v1/STATE.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ballNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99,
      "description": "1-based ball number within a game."
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000,
      "description": "Score as an integer; no decimals."
    },
    "ballInPlay": {
      "type": "boolean"
    },
    "tilt": {
      "type": "boolean"
    },
    "extraBalls": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "ballNumber",
    "score",
    "ballInPlay",
    "tilt",
    "extraBalls"
  ],
  "additionalProperties": false,
  "description": "client -> host at up to 10 Hz, mirrored host -> other clients with `from` preserved. Drives the overlay; never trusted for results."
}
