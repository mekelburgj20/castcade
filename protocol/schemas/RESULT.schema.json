{
  "$id": "https://castcade.dev/protocol/v3/RESULT.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "matchId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "The Throwdown code from ArcAid, or any unique string in a local/fake match."
    },
    "entries": {
      "minItems": 2,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "playerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "description": "Stable participant id for this match: the ArcAid user id, or a fakeclient label."
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000,
            "description": "Score as an integer; no decimals."
          },
          "ballsPlayed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": [
              "finished",
              "forfeit",
              "abandoned",
              "disconnected"
            ]
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "1 = winner; ties share a rank."
          }
        },
        "required": [
          "playerId",
          "score",
          "ballsPlayed",
          "status",
          "rank"
        ],
        "additionalProperties": false
      }
    },
    "winner": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "description": "Stable participant id for this match: the ArcAid user id, or a fakeclient label."
        },
        {
          "type": "null"
        }
      ],
      "description": "null on a tie for first."
    },
    "logHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lower-case hex SHA-256."
    },
    "logLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "hostSignature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$",
      "description": "Ed25519 signature, 64 raw bytes, base64, over canonical JSON."
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "playerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "description": "Stable participant id for this match: the ArcAid user id, or a fakeclient label."
          },
          "signature": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]+={0,2}$",
            "description": "Ed25519 signature, 64 raw bytes, base64, over canonical JSON."
          },
          "logHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Lower-case hex SHA-256."
          },
          "logLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "playerId",
          "signature",
          "logHash",
          "logLength"
        ],
        "additionalProperties": false
      },
      "description": "Every LOG_SIGN received, with the head each participant actually signed; missing or disagreeing ones are flagged on the ArcAid side, never rejected."
    },
    "hostTransfers": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "startedAt": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "description": "ts of the entry that started this game (MATCH_READY, or its NEXT_GAME)."
    },
    "finishedAt": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "game": {
      "default": 1,
      "description": "Which game of the series this result is for (A10). RESULT is not logged, so a default is harmless.",
      "type": "integer",
      "minimum": 1,
      "maximum": 999
    },
    "series": {
      "default": [],
      "description": "The series standings after this game, every participant who played any game of it (A10).",
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "playerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "description": "Stable participant id for this match: the ArcAid user id, or a fakeclient label."
          },
          "games": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Games of the series this player was in."
          },
          "wins": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Games this player won outright (a tie for first is nobody's win)."
          },
          "totalScore": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "The sum of their scores over those games."
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "By wins, then total score; ties share a rank."
          }
        },
        "required": [
          "playerId",
          "games",
          "wins",
          "totalScore",
          "rank"
        ],
        "additionalProperties": false,
        "description": "One player's standing in the series after this game."
      }
    }
  },
  "required": [
    "matchId",
    "entries",
    "winner",
    "logHash",
    "logLength",
    "hostSignature",
    "signatures",
    "hostTransfers",
    "startedAt",
    "finishedAt",
    "game",
    "series"
  ],
  "additionalProperties": false,
  "description": "host -> all, once per game (A10): the game's entries, signed over the log head at that game's end, and the series so far. Posted to ArcAid as one result of the Throwdown plus a castcade_matches record."
}
