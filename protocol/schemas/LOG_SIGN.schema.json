{
  "$id": "https://castcade.dev/protocol/v2/LOG_SIGN.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "logHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lower-case hex SHA-256."
    },
    "logLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$",
      "description": "The participant's signature over canonicalJson({matchId, logHash, logLength})."
    }
  },
  "required": [
    "logHash",
    "logLength",
    "signature"
  ],
  "additionalProperties": false,
  "description": "client -> host at game over, once every game in the match has ended."
}
