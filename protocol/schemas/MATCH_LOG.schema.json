{
  "$id": "https://castcade.dev/protocol/v6/MATCH_LOG.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "match": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "The match the entries belong to."
    },
    "restart": {
      "type": "boolean",
      "description": "True on the first page of a whole log: the receiver starts an empty log for `match`. False: the entries follow the ones the receiver holds."
    },
    "entries": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "prevHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Hash of the previous entry; 64 zeros before the first."
          },
          "ts": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "The causing message's own ts, never a local clock."
          },
          "kind": {
            "type": "string",
            "enum": [
              "msg",
              "grant",
              "event"
            ]
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "description": "Stable participant id for this match: the ArcAid user id, or a fakeclient label."
          },
          "message": {
            "description": "The logged envelope, verbatim; absent on an event entry.",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "event": {
            "description": "Present only when kind is event.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "host_transfer"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "host_left",
                  "host_requested"
                ]
              },
              "proposer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "description": "Stable participant id for this match: the ArcAid user id, or a fakeclient label."
              },
              "from": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "description": "The host before the transfer."
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "description": "The host after the transfer."
              },
              "newHostPublicKey": {
                "type": "string",
                "pattern": "^[A-Za-z0-9+/]+={0,2}$",
                "description": "Ed25519 public key, 32 raw bytes, base64."
              }
            },
            "required": [
              "type",
              "reason",
              "proposer",
              "from",
              "to",
              "newHostPublicKey"
            ],
            "additionalProperties": false
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "sha256(canonicalJson(entry without hash))."
          }
        },
        "required": [
          "index",
          "prevHash",
          "ts",
          "kind",
          "from",
          "hash"
        ],
        "additionalProperties": false,
        "description": "One entry of the hash-chained match log, exactly as every participant holds it."
      },
      "description": "The next entries of the log, in order, verbatim."
    },
    "logHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "The head of the log at the end of this page: the receiver's head once it has appended the entries (64 zeros for an empty log). Every page names the head of the log it carries."
    },
    "logLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "more": {
      "type": "boolean",
      "description": "Another page follows. False: the receiver is current, and the logged messages reach it live from here on."
    }
  },
  "required": [
    "match",
    "restart",
    "entries",
    "logHash",
    "logLength",
    "more"
  ],
  "additionalProperties": false,
  "description": "host -> client, in a lobby. The open match's log, to a member who does not hold it (it joined while the match was open, or its RECONNECT_ACK said `more`), in pages. The host sends such a member no logged message until the last page went out. Never logged."
}
