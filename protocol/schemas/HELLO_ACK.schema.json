{
  "$id": "https://castcade.dev/protocol/v2/HELLO_ACK.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "hostPlayerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "description": "Stable participant id for this match: the ArcAid user id, or a fakeclient label."
    },
    "hostPublicKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$",
      "description": "Clients verify every TURN_GRANT against this key."
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "playerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "description": "Stable participant id for this match: the ArcAid user id, or a fakeclient label."
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "publicKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]+={0,2}$",
            "description": "Ed25519 public key, 32 raw bytes, base64."
          },
          "rig": {
            "type": "string",
            "enum": [
              "pc",
              "vr_headset",
              "real_cabinet"
            ],
            "description": "The player's declared rig, for provenance (ArcAid badge, never a gate)."
          }
        },
        "required": [
          "playerId",
          "displayName",
          "publicKey",
          "rig"
        ],
        "additionalProperties": false
      },
      "description": "Everyone accepted so far, in join order."
    },
    "hostGame": {
      "default": null,
      "description": "The host's fingerprint, so a client the host accepted despite a difference (advisory mode) can show it too. null from a host that does not send it.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "vpx",
                "arcade"
              ],
              "description": "Emulator family."
            },
            "tableName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Human name of the table or ROM set."
            },
            "tableHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "SHA-256 of the ORIGINAL .vpx (never the patched copy), or of the arcade ROM zip."
            },
            "romName": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ],
              "description": "PinMAME ROM set name (e.g. mm_109c) or arcade ROM name; null for originals."
            },
            "romHash": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "description": "Lower-case hex SHA-256."
                },
                {
                  "type": "null"
                }
              ],
              "description": "SHA-256 of the ROM zip; null for originals."
            },
            "physicsHash": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "description": "Lower-case hex SHA-256."
                },
                {
                  "type": "null"
                }
              ],
              "description": "Hash of the physics-relevant table settings; null when not computed."
            },
            "recipeVersion": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 32
                },
                {
                  "type": "null"
                }
              ],
              "description": "Castcade patch recipe version applied to this table (ADR 0004); null for arcade."
            },
            "sidecarHash": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "description": "Lower-case hex SHA-256."
                },
                {
                  "type": "null"
                }
              ],
              "description": "SHA-256 of the generated sidecar .vbs; proves both players run the same patch."
            },
            "emulatorVersion": {
              "type": "string",
              "maxLength": 64,
              "description": "VPX or RetroArch core version string."
            }
          },
          "required": [
            "kind",
            "tableName",
            "tableHash",
            "romName",
            "romHash",
            "physicsHash",
            "recipeVersion",
            "sidecarHash",
            "emulatorVersion"
          ],
          "additionalProperties": false,
          "description": "Everything that must match between participants for a fair match. The host compares these at HELLO."
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "hostPlayerId",
    "hostPublicKey",
    "participants",
    "hostGame"
  ],
  "additionalProperties": false,
  "description": "host -> client. The HELLO was accepted; the match is not ready until MATCH_READY. Sent again to every client while in the lobby when a PARTICIPANT_UPDATE (or the host itself) changed the roster or the host fingerprint."
}
