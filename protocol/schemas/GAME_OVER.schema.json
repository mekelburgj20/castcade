{
  "$id": "https://castcade.dev/protocol/v2/GAME_OVER.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "finalScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000,
      "description": "Score as an integer; no decimals."
    },
    "ballsPlayed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "finalScore",
    "ballsPlayed"
  ],
  "additionalProperties": false,
  "description": "client -> host when that side's game reaches game over."
}
