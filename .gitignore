# Temp / scratch — never tracked
tmp/

# Node
node_modules/
dist/
build/
out/
*.tsbuildinfo

# Secrets / local config
.env
.env.*
*.local

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Logs
*.log

# Python
__pycache__/

# Castcade companion: packaging output and the fetched maps corpus (never tracked)
companion/release/
companion/resources/
# companion/build holds committed icon assets; the generic build/ rule above would hide it
!companion/build/
