{
  "name": "@castcade/companion",
  "version": "0.2.15",
  "productName": "Castcade",
  "private": true,
  "description": "Castcade companion: Electron desktop app (host/client match engine, Witness producer, media, launch).",
  "license": "GPL-3.0-only",
  "author": "Justin Mekelburg",
  "type": "module",
  "main": "dist/main/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "tsc -b && vite",
    "smoke": "electron . --smoke",
    "typecheck:renderer": "tsc -p renderer --noEmit",
    "fetch-maps": "node scripts/fetch-maps.mjs",
    "fetch-vps": "node scripts/fetch-vps.mjs",
    "spike:stream": "tsc -b && electron scripts/stream-spike.mjs",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "release:win": "npm run build && electron-builder --win --publish always",
    "pack:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@castcade/protocol": "*",
    "electron-updater": "^6.8.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cfb": "1.2.2",
    "electron": "44.9.0",
    "electron-builder": "^26.15.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^8.3.4"
  }
}
