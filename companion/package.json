{
  "name": "@castcade/companion",
  "version": "0.2.39",
  "productName": "Castcade",
  "private": true,
  "description": "Castcade companion: Electron desktop app (host/client match engine, Witness producer, media, launch).",
  "license": "GPL-3.0-only",
  "author": "Justin Mekelburg",
  "type": "module",
  "main": "dist/main/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "tsc -b && vite",
    "smoke": "electron . --smoke",
    "typecheck:renderer": "tsc -p renderer --noEmit",
    "fetch-maps": "node scripts/fetch-maps.mjs",
    "fetch-vps": "tsx scripts/fetch-vps.ts",
    "playfield-tags": "tsx scripts/playfield-tags.ts",
    "witness-games": "tsx scripts/witness-games.ts",
    "validate-original": "tsx scripts/validate-original.ts",
    "fetch-ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "fetch-vr-overlay": "node scripts/fetch-vr-overlay.mjs",
    "fetch-vr-layer": "node scripts/fetch-vr-layer.mjs",
    "fetch-audio-helper": "node scripts/fetch-audio-helper.mjs",
    "fetch-video-helper": "node scripts/fetch-video-helper.mjs",
    "ffmpeg-source": "node scripts/ffmpeg-source.mjs",
    "spike:stream": "tsc -b && electron scripts/stream-spike.mjs",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "release:win": "npm run build && electron-builder --win --publish always",
    "pack:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@castcade/protocol": "*",
    "electron-updater": "^6.8.9",
    "socket.io-client": "^4.8.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cfb": "1.2.2",
    "electron": "44.9.0",
    "electron-builder": "^26.15.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.4",
    "vite": "^8.3.4"
  }
}
